<% if @body.present? %>
  <%= render 'custom_content', content: @body, submitter: @submitter %>
<% else %>
  <% doc = @submitter.submission.name || @submitter.submission.template&.name %>
  <% total = @submitter.submission.submitters.count %>
  <% content_for :preheader, "All #{total} signatures are in. The signed copy is attached." %>
  <p><%= doc %> now has all <%= total %> signatures.</p>
  <p>The signed copy is attached to this email. Keep it with your records.</p>
  <%= render 'shared/email_button', label: 'Download signed copy', url: submission_url(@submitter.submission) %>
<% end %>
